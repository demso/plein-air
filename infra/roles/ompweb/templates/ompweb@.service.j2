[Unit]
Description=ompweb instance for %i
Documentation=https://github.com/kahme247/ompweb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/home/%i/.omp/agent/web-service.env
ExecStart=/usr/bin/ompweb --no-open
Restart=on-failure
RestartSec=5
# Агенту нужен доступ к домашним каталогам и /tmp — sandboxing минимальный.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
